# =============================================================================
# Environment variables for Mohammad Warish Ansari Portfolio
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is gitignored.
# =============================================================================

# Gemini API key — server-side ONLY, never exposed to the client.
# Generate/rotate at: https://aistudio.google.com/app/apikey
# After rotating, update Vercel environment variables under Project → Settings → Environment Variables.
# IMPORTANT: Do NOT wrap the value in quotes!
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (server-configurable, no redeploy needed for model changes).
# Default when unset: gemini-2.5-flash
# Verified available models: gemini-3.8-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
